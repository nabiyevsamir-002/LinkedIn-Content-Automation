        "numbers": [],
        "quotes": [
          {
            "text": "As AI agents become increasingly capable and autonomous, the risks associated with this level of access will grow substantially.",
            "speaker": "Apple (developer bloqu)",
            "source_url": "https://developer.apple.com/news/?id=p6zjojqw"
          },
          {
            "text": "We will introduce additional controls to ensure that users who genuinely wish to grant an app this extraordinary level of access can only do so with very explicit user action.",
            "speaker": "Apple (developer bloqu)",

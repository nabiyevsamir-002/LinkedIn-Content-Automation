# M1 üçün API açarı LAZIM DEYİL — Claude Pro abunəliyi istifadə olunur.
# Bir dəfə terminalda işlədin:  claude setup-token
# Alınan tokeni bura yazın (GitHub Actions-da da eyni ad istifadə olunacaq):
CLAUDE_CODE_OAUTH_TOKEN=

# --- Model seçimi ---
MODEL_SCOUT=haiku
MODEL_MAIN=sonnet

# --- Davranış ---
MAX_ITEM_AGE_HOURS=36
CLAUDE_SAFE_MODE=1
CLAUDE_BIN=claude

# --- M2: şəkillər ---
# Pulsuz açar: pexels.com/api  (foto pillələri üçün; boş qalsa atlanır)
PEXELS_API_KEY=
# Opsional, ödənişli son pillə: AI foto generasiyası
OPENAI_API_KEY=
IMAGE_PROVIDER=openai
# Chrome başqa yerdədirsə:
# CHROME_BIN=

# --- M3: Telegram təsdiqi ---
# @BotFather → /newbot → token
TELEGRAM_BOT_TOKEN=
# Bota bir mesaj yazın, sonra: make tg-chatid
TELEGRAM_CHAT_ID=
# Yayım saatı (UTC) və həftəsonu rejimi
PUBLISH_HOUR_UTC=8
PUBLISH_WEEKENDS=0

# --- M4: LinkedIn yayımı ---
# linkedin.com/developers/apps → Auth bölməsi
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# App-in «Authorized redirect URLs» sahəsinə eynilə bu yazılmalıdır:
LINKEDIN_REDIRECT_URI=http://localhost:8765/callback
LINKEDIN_API_VERSION=202509

# --- M3b: Notion Kanban ---
NOTION_TOKEN=
NOTION_DATABASE_ID=

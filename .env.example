# M1 üçün API açarı LAZIM DEYİL — Claude Pro abunəliyi istifadə olunur.
# Bir dəfə terminalda işlədin:  claude setup-token
# Alınan tokeni bura yazın (GitHub Actions-da da eyni ad istifadə olunacaq):
CLAUDE_CODE_OAUTH_TOKEN=

# --- Model seçimi ---
MODEL_SCOUT=haiku
MODEL_MAIN=sonnet

# --- Davranış ---
MAX_ITEM_AGE_HOURS=36
CLAUDE_SAFE_MODE=1
CLAUDE_BIN=claude

# --- M2: şəkillər ---
# Pulsuz açar: pexels.com/api  (foto pillələri üçün; boş qalsa atlanır)
# Foto mənbələri — nə qədər çox olsa, uyğun şəkil tapmaq şansı bir o qədər yüksəkdir.
# Openverse açarsız işləyir (artıq aktivdir). Qalanları pulsuzdur:
#   Pexels   → pexels.com/api
#   Unsplash → unsplash.com/developers  (Demo app kifayətdir)
#   Pixabay  → pixabay.com/api/docs
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=
PEXELS_API_KEY=
# Opsional, ödənişli son pillə: AI foto generasiyası
OPENAI_API_KEY=
IMAGE_PROVIDER=openai
# Chrome başqa yerdədirsə:
# CHROME_BIN=

# --- M3: Telegram təsdiqi ---
# @BotFather → /newbot → token
TELEGRAM_BOT_TOKEN=
# Bota bir mesaj yazın, sonra: make tg-chatid
TELEGRAM_CHAT_ID=
# Yayım saatı (UTC) və həftəsonu rejimi
PUBLISH_HOUR_UTC=8
PUBLISH_WEEKENDS=0

# --- M4: LinkedIn yayımı ---
# linkedin.com/developers/apps → Auth bölməsi
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# App-in «Authorized redirect URLs» sahəsinə eynilə bu yazılmalıdır:
LINKEDIN_REDIRECT_URI=http://localhost:8765/callback
# Boş buraxın — sistem aktiv versiyaları özü aşkarlayır və ən yenisini
# işlədir. Versiya sıradan çıxsa avtomatik keçid olur, yayım dayanmır.
# Yalnız konkret versiyaya bərkitmək istəsəniz doldurun.
LINKEDIN_API_VERSION=

# --- Xarici sağlamlıq monitorinqi (tövsiyə olunur) ---
# healthchecks.io → pulsuz hesab → yeni «check» → ping URL-ini bura yazın.
# Sistem gözlənilən vaxtda siqnal göndərməsə xidmət SİZƏ xəbərdarlıq edir.
# Daxili bildirişlər bunu edə bilməz — sistem dayanıbsa onlar da işləmir.
HEALTHCHECK_URL=

# --- Brend (şəkildəki imza) ---
# Vurğu rəngi — bütün şəkillərdə vahid stil (məs. #38bdf8). Boş = avtomatik
BRAND_COLOR=
# Loqo faylı: assets/logo.png və ya assets/logo.svg (opsional)
# QEYD: `news` xəbər kartı loqonu birbaşa assets/logo.svg-dən inline
# oxuyur — bu dəyişən ona təsir etmir, yalnız digər şablonlar üçündür.
BRAND_LOGO=
BRAND_NAME=
BRAND_HANDLE=

# --- Agent büdcələri (kvota qoruyucusu) ---
AGENT_BUDGET_USD=0.25
RESEARCH_BUDGET_USD=0.45
RESEARCH_MAX_TURNS=8

# --- M3b: Notion Kanban ---
# notion.so/my-integrations → Internal Integration Secret
# DİQQƏT: Notion səhifəsini açıb ··· → Connections → inteqrasiyanı əlavə edin,
# yoxsa API «object_not_found» qaytarır.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# --- Vaxt zonası və yayım saatı ---
# Bütün mesajlarda bu zona göstərilir (daxildə həmişə UTC saxlanılır)
TIMEZONE=Asia/Baku
# Yayım saatı YERLİ vaxtla: 12 = günorta 12:00 Bakı vaxtı
# --- Yayım sürəti (ən vacib qoruyucular) ---
# Bank hər tick-də bir post yayımlaya bilərdi: 5 postluq bank
# 75 dəqiqəyə boşalırdı. Bu iki hədd onun qarşısını alır.
MAX_POSTS_PER_DAY=1
MIN_HOURS_BETWEEN_POSTS=6

PUBLISH_HOUR=12
PUBLISH_WEEKENDS=0
